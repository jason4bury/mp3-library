# Copy this file to .env and edit the values for your setup, then run:
#   docker compose up -d --build
#
# IMPORTANT if you're using Docker (docker-compose.yml): every value below is read by
# docker-compose.yml automatically (via ${VAR} substitution) — this is now the ONLY file
# you need to edit. You should not need to open docker-compose.yml at all.

# Port exposed on your host (http://<your-server>:PORT)
PORT=3000

# --- Your music folder(s), as they exist on THIS machine (the Docker host) ---
# One folder: fill in MUSIC_HOST_DIR_1 and delete/ignore MUSIC_HOST_DIR_2 (and its line in
# docker-compose.yml's volumes: section, and drop ",/music/collection2" from MUSIC_DIR below).
# More than two folders? Add MUSIC_HOST_DIR_3 etc., with a matching volume line in
# docker-compose.yml and another /music/collection3 appended to MUSIC_DIR below.
MUSIC_HOST_DIR_1=/path/to/your/first/music/folder
MUSIC_HOST_DIR_2=/path/to/your/second/music/folder

# Where artist pictures live on THIS machine, one subfolder per artist, e.g.
#   Artist Pics/Radiohead/folder.jpg
ARTIST_PICTURES_HOST_DIR=/path/to/Artist Pictures

# --- Paths INSIDE the container — you normally don't need to change these ---
# They just need to match the container-side paths used in docker-compose.yml's volumes:
# section (the right-hand side of each "host:container" mapping above).
MUSIC_DIR=/music/collection1,/music/collection2
ARTIST_PICTURES_DIR=/artist-pictures
DATA_DIR=/data

# Login credentials for the web UI — required since you're exposing this to the internet.
# Change these before you deploy.
APP_USERNAME=admin
APP_PASSWORD=change-me

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Optional: powers the "About" section (bio, tags, similar artists, listener stats) on the
# Artist Info tab, the Radio (📻 similar-tracks queue) feature, and — once you also set
# LASTFM_API_SECRET below and connect your account from Settings in the app — scrobbling.
# Free — create an account and get a key/secret at https://www.last.fm/api/account/create
# (only "Application name" and a contact email are required). Leave both blank/unset to skip
# Last.fm entirely — the rest of the app works fine without it: the Artist Info tab just won't
# show that section, Radio falls back to same-genre/same-artist queues, and the Settings modal
# won't offer scrobbling.
LASTFM_API_KEY=

# Required only for scrobbling (see LASTFM_API_KEY above) — the "Shared secret" shown on the
# same Last.fm API account page. Not needed just for artist/album info or Radio.
LASTFM_API_SECRET=

# --- Only relevant if you run this WITHOUT Docker (`node server/index.js` directly) ---
# In that case MUSIC_DIR/ARTIST_PICTURES_DIR/DATA_DIR above are used as real paths on this
# machine (not container paths) — e.g. MUSIC_DIR=d:/music,d:/soundtracks — and
# MUSIC_HOST_DIR_1/2 and ARTIST_PICTURES_HOST_DIR are ignored entirely.
